# Ativacao
BETEL_SYNC_ENABLED=false
BETEL_SOURCE=olx

# Fonte autorizada pela OLX (preencher somente quando fornecida oficialmente)
BETEL_SOURCE_ENDPOINT=
BETEL_SOURCE_TOKEN=

# Politica de disponibilidade
BETEL_UNAVAILABLE_AFTER_MISSES=2
BETEL_REMOVE_AFTER_HOURS=168

# Supabase - nunca commitar valores reais de service role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
