# Sincronização oficial/autorizada
BETEL_SYNC_ENABLED=false
BETEL_SOURCE=olx
BETEL_SOURCE_ENDPOINT=
BETEL_SOURCE_TOKEN=
BETEL_UNAVAILABLE_AFTER_MISSES=2
BETEL_REMOVE_AFTER_HOURS=168

# Descoberta web via Brave Search
BETEL_WEB_DISCOVERY_ENABLED=false
BRAVE_SEARCH_API_KEY=
BETEL_DISCOVERY_DOMAINS=olx.com.br,vivareal.com.br
# Opcional: sobrescrever os grupos padrão usados pelo adaptador
BETEL_DISCOVERY_GROUPS=
BETEL_DISCOVERY_RESULTS_PER_QUERY=20
BETEL_DISCOVERY_UNAVAILABLE_AFTER_MISSES=6
BETEL_DISCOVERY_REMOVE_AFTER_HOURS=336

# Supabase - nunca commitar valores reais de service role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
